#!/bin/sh /etc/rc.common
START=95
STOP=10
USE_PROCD=1

start_service() {
	local enabled interface control_dir
	config_load aredn-dfs-detector
	config_get_bool enabled main enabled 0
	[ "$enabled" -eq 1 ] || return 0
	config_get interface main interface
	config_get control_dir main control_dir
	if [ -z "$interface" ] || [ -z "$control_dir" ]; then
		echo 'aredn-dfs-detector: configure interface and control_dir first' >&2
		return 1
	fi
	procd_open_instance
	procd_set_param command /usr/sbin/aredn-dfs-collector "$interface" "$control_dir"
	procd_set_param stdout 1
	procd_set_param stderr 1
	# No respawn: a source failure must remain a visible coverage gap.
	procd_close_instance
}
